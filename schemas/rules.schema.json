{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["claims"],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
      }
    }
  }
}
